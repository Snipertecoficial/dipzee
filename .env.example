# Copy this file to `.env` in the repo root and fill in real values before
# running `docker compose up --build`. Never commit the real `.env`.

# ---- Runtime -----------------------------------------------------------
ENV=production
DOMAIN=seudominio.com

# ---- MongoDB -------------------------------------------------------------
# MONGO_URL is derived automatically in docker-compose.yml. Root credentials
# are used ONLY for cluster administration (see mongo-init/init-app-user.js);
# the backend connects with MONGO_APP_USER, which is scoped to readWrite on
# DB_NAME only — never the root/admin account.
MONGO_ROOT_USER=dipzee_admin
MONGO_ROOT_PASSWORD=changeme-strong-password
MONGO_APP_USER=dipzee_app
MONGO_APP_PASSWORD=changeme-different-strong-password
DB_NAME=dipzee_production

# ---- Auth ------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Short-lived access token; long-lived but revocable refresh token (see
# backend/refresh_tokens.py) is what actually keeps a session alive.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=https://seudominio.com
# Canonical origin used for password-reset links. Never accept it from clients.
PUBLIC_APP_URL=https://seudominio.com
# Exact comma-separated webhook hosts approved for outbound alert delivery.
# Keep empty to disable webhooks safely. Wildcards must be explicit (*.example.com).
WEBHOOK_ALLOWED_HOSTS=
# Required before storing rotatable provider keys in MongoDB; base64(32 random bytes).
APP_ENCRYPTION_KEY=
ADMIN_MFA_REQUIRED=true
ADMIN_AUDIT_RETENTION_DAYS=365
MARKET_REFRESH_CONCURRENCY=5

# Superadmin account(s), created/updated on every backend startup. No
# built-in fallback exists anymore — if unset, no superadmin is seeded.
SUPERADMIN_EMAIL=voce@seudominio.com
SUPERADMIN_PASSWORD=

# ---- Stripe (live keys) ------------------------------------------------
STRIPE_API_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# From the Stripe webhook endpoint pointed at https://seudominio.com/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Email (Resend) ----------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Dipzee <noreply@seudominio.com>

# ---- AI analyst (Anthropic, Gemini or OpenAI) --------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
GOOGLE_API_KEY=
GEMINI_MODEL=
# Only needed if AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---- Optional: error tracking (Sentry) ---------------------------------
# When set, the backend reports unhandled errors to Sentry. No-op if empty.
SENTRY_DSN=

# ---- Optional: force a single market-data provider ---------------------
# Leave empty to auto-select. Set to a provider name (e.g. "fmp") to pin it.
PRIMARY_PROVIDER=

# ---- Optional: Telegram alerts -----------------------------------------
TELEGRAM_BOT_TOKEN=

# ---- Optional: market data providers (yfinance is the built-in default,
# not licensed for commercial use — set one of these before charging users) --
FINNHUB_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
MARKETSTACK_API_KEY=

# ---- LSE (London Strategic Edge) intelligence layer --------------------
# Powers the market-intelligence features (candles/fundamentals/options/macro).
# Server-side only — never expose this key to the frontend. When unset, the LSE
# ingestion job and endpoints are no-ops, so the rest of the app is unaffected.
LSE_API_KEY=
# Budget guard: hard local ceiling on LSE calls per rolling hour, and the
# minimum fraction of the vault export budget to keep in reserve (a call is
# refused below it). Defaults are conservative.
LSE_MAX_CALLS_PER_HOUR=500
LSE_BUDGET_RESERVE=0.05
# Whether raw LSE-derived data may be surfaced to clients. Rights were granted
# by LSE, so this is an operational toggle — leave "off" until the client
# surface exists (nothing to expose yet); set "on" to enable it.
LSE_CLIENT_RAW_EXPOSURE=off

# ---- Market event correlation (news -> asset impact) -------------------
# When "on", the scheduler correlates fresh market news into enriched events
# every 30 min. Off by default because each new headline costs one LLM call
# (dedup means steady-state only NEW headlines are processed). On-demand
# correlation via the admin panel works regardless of this flag.
EVENT_CORRELATION_ENABLED=off
EVENT_CORRELATION_MAX_PER_RUN=10

# ---- Proprietary dataset (inference/decision logging) ------------------
# Every model inference (context -> output) and anonymized user decision is
# logged to build the training dataset. No PII is stored — users are referenced
# only by a salted one-way pseudonym. DATASET_SALT keeps that pseudonym stable
# and non-reversible (required and independent in production). Rows past
# DATASET_RETENTION_DAYS are pruned daily (LGPD).
DATASET_SALT=
DATASET_RETENTION_DAYS=540

# ---- Database backup ---------------------------------------------------
# A gzipped snapshot is written daily (03:30 ET) to a persistent Docker volume
# — free, no config needed, survives redeploys. Optionally ALSO upload it
# offsite to any S3-compatible store (AWS S3, Backblaze B2, Cloudflare R2 —
# all have a free tier big enough for this small DB). Leave the S3 vars empty
# to keep backups local-only. BACKUP_KEEP = how many local snapshots to retain.
BACKUP_KEEP=7
# Required: base64 encoding of exactly 32 random bytes. Never reuse JWT_SECRET.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Endpoint is required only for non-AWS S3-compatibles (B2/R2). Examples:
#   Backblaze B2:   https://s3.us-west-004.backblazeb2.com
#   Cloudflare R2:  https://<accountid>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=dipzee-backups
# Set empty only if the S3-compatible provider does not support server-side encryption.
BACKUP_S3_SSE=AES256

# ---- Frontend (baked into the JS bundle at build time) -----------------
REACT_APP_BACKEND_URL=https://seudominio.com
